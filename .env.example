BOT_TOKEN=your_bot_token_here
DATABASE_URL=sqlite+aiosqlite:///shopcrm.db
LOG_LEVEL=INFO
DEBUG=false
ADMIN_ID=[]

# FSM storage backend: "memory" (default) or "redis".
FSM_STORAGE=memory
# Redis URL, used only when FSM_STORAGE=redis.
REDIS_URL=redis://localhost:6379/0
# Shop manager URL (Telegram profile) for the "Manager" button on the
# product card. If empty, the button is hidden.
MANAGER_URL=
# Directory for rotating log files.
LOGS_DIR=logs
