BOT_TOKEN=your_bot_token_here
DATABASE_URL=sqlite+aiosqlite:///shopcrm.db
LOG_LEVEL=INFO
DEBUG=false
ADMIN_ID=[]

# FSM storage backend: "memory" (default) or "redis".
FSM_STORAGE=memory
# Redis URL, used only when FSM_STORAGE=redis.
REDIS_URL=redis://localhost:6379/0
# Shop manager URL (Telegram profile) for the "Manager" button on the
# product card. If empty, the button is hidden.
MANAGER_URL=
# Directory for rotating log files.
LOGS_DIR=logs
# How many days to keep the order status change journal (order_status_history).
# Values <= 0 disable automatic cleanup (the journal is kept forever).
AUDIT_RETENTION_DAYS=180

# ==================== BROADCAST (admin "Broadcast" section) ====================
# Cooldown (hours) after a send: users who already received a broadcast within
# this window are skipped (anti-spam). 0 (default) disables the cooldown —
# a new broadcast simply cannot start until the previous one is finished.
BROADCAST_COOLDOWN_HOURS=0
# Send rate limit (messages per second per shop).
BROADCAST_MAX_RPS=10
# How many messages are sent in parallel (semaphore).
BROADCAST_CONCURRENCY=10
# Chunk size: recipients per pass + commit of marks.
BROADCAST_CHUNK_SIZE=50
# How many times to retry a send on transient failures (network / 429).
BROADCAST_RETRY_ATTEMPTS=3
# Base delay between retries on network failures (seconds, grows linearly).
BROADCAST_RETRY_DELAY=5
# Interrupted broadcasts older than this (hours) are not auto-resumed after a
# bot restart. <= 0 disables auto-resume.
BROADCAST_RESUME_MAX_AGE_HOURS=24
